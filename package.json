{
  "name": "starmaker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --outfile=.cache/test/smoke.cjs --log-level=error --external:jsdom && node .cache/test/smoke.cjs",
    "single": "npm run build && node scripts/bundle-html.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
